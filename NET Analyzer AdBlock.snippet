# ============================================================
# 终极去广告 snippet - 追求【极速、稳定、零卡顿】
# 基于 quantumult-x-2026-06-06-120141.har 日志定制
# ============================================================

[filter_local]
# --- 1. 核心双击广告与 AdMob 体系 (Reject-Drop 阻断，不返回任何数据，App 闪电跳过)
host-keyword, doubleclick.net, reject-drop
host-keyword, googleads, reject-drop
host-keyword, pagead, reject-drop

# --- 2. 统计、日志与域名分发（ har 日志中的 odf 服务与谷歌数据 choices ）
host, firebaselogging-pa.googleapis.com, reject-drop
host, odf.app-ads-services.com, reject-drop
host, fundingchoicesmessages.google.com, reject-drop

# --- 3. 第三方 DSP 广告平台 (har 日志中高频出现的 Smadex 广告商)
host-keyword, smadex.com, reject-drop

[rewrite_local]
# 抛弃所有复杂脚本！仅保留一行极致的“空对象”伪装，专门对付部分 App 严格的初始化校验
^https?:\/\/fundingchoicesmessages\.google\.com\/a\/consent url request-header (\r\n) request-header Reject-Drop

[mitm]
# 尽量缩减 MitM 范围，只有必要时才解密，以此确保最高网速
hostname = fundingchoicesmessages.google.com