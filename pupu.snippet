#!name=朴朴超市
#!desc=朴朴超市去广告，默认接管模式可用版 (完全自主托管版)
#!author=wugejuhao

[filter_local]
# 拦截 HTTPDNS 对应的特定 IP，防止 App 绕过代理
ip-cidr, 139.196.12.179/32, reject
ip-cidr, 106.55.220.18/32, reject
ip-cidr, 54.222.159.138/32, reject
ip-cidr, 101.42.130.147/32, reject

[rewrite_local]
# --- URL Rewrite ---
# 直接丢弃 HTTPDNS 解析请求
^http:\/\/139\.196\.12\.179:8053\/httpdns\/ url reject
^http:\/\/106\.55\.220\.18:8053\/httpdns\/ url reject
^http:\/\/54\.222\.159\.138:8053\/httpdns\/ url reject
^http:\/\/101\.42\.130\.147\/httpdns\/resolve\/ url reject

# --- Map Local 替代 (返回空字典) ---
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/search_input_ranking url reject-dict
^https:\/\/j1\.pupuapi\.com\/client\/assets\/discount\/order url reject-dict
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/channel\/global_redeem\/top_tip\/v2 url reject-dict
^https:\/\/j1\.pupuapi\.com\/client\/recommendation\/hub\/interests\/products\/v2 url reject-dict
^https:\/\/j1\.pupuapi\.com\/client\/member_card\/premium\/user_center url reject-dict

# --- 消除红点/未读消息面板 ---
^https:\/\/j1\.pupuapi\.com\/client\/notification\/message_center\/unread_number url reject-dict

# --- 本地托管脚本映射 (指向 wugejuhao 自己的仓库) ---
^https:\/\/j1\.pupuapi\.com\/client\/search\/hot_keywords\/v3 url script-response-body https://raw.githubusercontent.com/wugejuhao/new-day/main/pupu_ad.js
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/v1 url script-response-body https://raw.githubusercontent.com/wugejuhao/new-day/main/pupu_ad.js
^https:\/\/j1\.pupuapi\.com\/client\/search\/hub\/search_box\/products\/v6 url script-response-body https://raw.githubusercontent.com/wugejuhao/new-day/main/pupu_ad.js
^https:\/\/j1\.pupuapi\.com\/client\/order_settlement\/detail url script-response-body https://raw.githubusercontent.com/wugejuhao/new-day/main/pupu_ad.js
^https:\/\/j1\.pupuapi\.com\/client\/order\/orders\/list\/v4 url script-response-body https://raw.githubusercontent.com/wugejuhao/new-day/main/pupu_ad.js

[mitm]
hostname = j1.pupuapi.com
