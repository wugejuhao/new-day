# ---------- ① 强制阻断非亚洲区测速 (利用KEYWORD斩断动态哈希) ----------

# ⛔ 强锁区：拦截印度 (India)
HOST-KEYWORD, gromelink-link-in, REJECT
HOST-KEYWORD, gromelink-pingin, REJECT
HOST-KEYWORD, indspeed, REJECT

# ⛔ 强锁区：拦截土耳其/中东 (Turkey/ME)
HOST-KEYWORD, gromelink-link-tr, REJECT
HOST-KEYWORD, gromelink-pingtr, REJECT

# ⛔ 强锁区：拦截美洲/巴西 (America/Brazil)
HOST-KEYWORD, gromelink-link-us, REJECT
HOST-KEYWORD, gromelink-ping-us, REJECT
HOST-KEYWORD, gromelink-link-sa, REJECT
HOST-KEYWORD, gromelink-pingsa, REJECT
HOST-KEYWORD, gromelink-link-br, REJECT
HOST-KEYWORD, gromelink-pingbr, REJECT
HOST-KEYWORD, brspeed, REJECT

# ⛔ 强锁区：拦截欧洲 (Italy/Finland)
HOST-KEYWORD, gromelink-link-it, REJECT
HOST-KEYWORD, gromelink-pingit, REJECT
HOST-KEYWORD, gromelink-link-fi, REJECT
HOST-KEYWORD, gromelink-pingfi, REJECT

# ⛔ 阻断定位与隐私遥测 (防锁区漏网核心)
HOST, hok-lbs.intlgame.com, REJECT
HOST, galileotelemetry.tencent.com, REJECT
HOST-KEYWORD, appsflyersdk, REJECT


# ---------- ② 强制保送东南亚直连测速 (确保 20ms) ----------
# 明确放行新加坡(SG)等亚太测速节点，告诉系统我们在这连得最快
HOST-KEYWORD, gromelink-pingsg, DIRECT
HOST-KEYWORD, gromelink-link-sg, DIRECT
HOST-KEYWORD, sgspeed, DIRECT


