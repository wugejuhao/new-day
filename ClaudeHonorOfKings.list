# ===== DIRECT：可能被 proxy lite/订阅截走的游戏域名 =====
# hok-dr 在 log 里走过 FINAL（旧配置），现在 FINAL=DIRECT 没问题，
# 但 proxy lite 里如果有 intlgame.com 代理规则会截走，显式写 DIRECT 保险
HOST, hok.intlgame.com, DIRECT
HOST, hok-dr.intlgame.com, DIRECT
HOST, hok-vman.intlgame.com, DIRECT
HOST-SUFFIX, intlgame.cn, DIRECT

# zga.net 在 log 里走过 FINAL，proxy lite 可能有 AWS 相关规则截走
HOST-SUFFIX, zga.net, DIRECT
HOST-SUFFIX, awsglobalaccelerator.com, DIRECT

# sgameglobal.com cdn 路径，proxy lite 里常见 cloudflare 规则会截走
HOST-SUFFIX, sgameglobal.com.cdn.cloudflare.net, DIRECT
HOST-SUFFIX, sgameglobal.com.acc.edgeonedy1.com, DIRECT
HOST-SUFFIX, 2c450f6kyrw9.eo.dnse3.com, DIRECT

# ===== JP：资源下载 =====
HOST, download.sgameglobal.com, JP
HOST, v2-down-gamelet.sgameglobal.com, JP
HOST, down.gamelet.games, JP
HOST, dl.listdl.com, JP
HOST-SUFFIX, hokglobalgcloud.iegcom.com, JP

# ===== DIRECT：对战服务器 IP 网段 =====
# proxy lite 里通常有大段 IP 规则，这几个段必须显式写直连
IP-CIDR, 96.0.64.0/18, DIRECT, no-resolve
IP-CIDR, 160.32.0.0/16, DIRECT, no-resolve
IP-CIDR, 160.96.0.0/16, DIRECT, no-resolve
IP-CIDR, 160.224.0.0/16, DIRECT, no-resolve
IP-CIDR, 176.251.0.0/16, DIRECT, no-resolve
