# ==========================================
# 👑 王者荣耀国际服 (HoK Global) 顶级精确防劫持版
# 策略环境：
# 1. 代理策略名：World
# 2. 兜底策略 (FINAL)：直连 (DIRECT)
# 逻辑：使用最霸道的 HOST-WILDCARD 拦截动态哈希云 CDN，全面碾压 Proxy List
# ==========================================

# ---------- ① 核心防查水表 (精确匹配拦截) ----------
HOST, hok-lbs.intlgame.com, REJECT
HOST, hok-gcloudctrl.iegcom.com, REJECT
HOST, galileotelemetry.tencent.com, REJECT
HOST, sg.galileotelemetry.tencent.com, REJECT
HOST-SUFFIX, appsflyersdk.com, REJECT

# ---------- ② 账号鉴权与通行证 (精确匹配走 World) ----------
HOST, hok.intlgame.com, World
HOST, hok-sg-act.playerinfinite.com, World

# ---------- ③ 游戏热更新 CDN (精确匹配走 World) ----------
HOST, download.sgameglobal.com, World
HOST, v2-down-gamelet.sgameglobal.com, World
HOST, down.gamelet.games, World
# 锁定：日志中带随机数字的动态游戏下载网段
HOST-WILDCARD, download.*.hokglobalgcloud.iegcom.com, World

# ---------- ④ 动态哈希全球加速 CDN (强通配符精确锁定直连) ----------
# 【核心增强】拦截日志中所有被云厂商泛解析劫持的风险
# 1. 锁定 EdgeOne 腾讯云动态哈希加速
HOST-WILDCARD, *.sgameglobal.com.acc.edgeonedy1.com, DIRECT
# 2. 锁定 ZGA 动态哈希全站加速
HOST-WILDCARD, *.zga.globalconnetct.com, DIRECT
# 3. 锁定 AWS 亚马逊全球高延迟加速器误杀
HOST-WILDCARD, *.awsglobalaccelerator.com, DIRECT
# 4. 锁定 Cloudflare 动态测速与资产分发
HOST-WILDCARD, *.sgameglobal.com.cdn.cloudflare.net, DIRECT

# ---------- ⑤ 局内静态资源及大厅 (精确匹配走 DIRECT) ----------
# 再次加固：锁定常规非动态域名，防止被 Proxy List 的后缀规则吸走
HOST, res.sgameglobal.com, DIRECT
HOST, mna.sgameglobal.com, DIRECT
HOST, prod-broker.sgameglobal.com, DIRECT
HOST, act.sgameglobal.com, DIRECT
HOST, hok-op-sg.sgameglobal.com, DIRECT
HOST, camp.honorofkings.com, DIRECT
HOST, api-camp.honorofkings.com, DIRECT
HOST, sg.tux.qq.com, DIRECT
HOST, dlied5.qq.com, DIRECT

