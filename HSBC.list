#!name=汇丰银行 (HSBC & Reward+) 完整分流与防风控
#!desc=确保汇丰主业务、1865底层云与反欺诈指纹IP高度统一，并强制豁免MitM解密防止断连。
#!author=wugejuhao

# =========================================
# 1. 分流规则部分 (供 [filter_remote] 读取)
# =========================================
host-suffix, vv1865.com, direct
host-suffix, online-metrix.net, direct
host-suffix, we-stats.com, direct
host, hsbc.edge.sdk.awswaf.com, direct
host, www.redhotoffers.hsbc.com.hk, direct
host, cdnhsbcrhostorage.azureedge.net, direct
host-keyword, hsbc, direct
host-suffix, hsbc.com, direct
host-suffix, hsbc.com.hk, direct
host-suffix, hsbc.com.cn, direct
host-suffix, hsbc.co.uk, direct
host-suffix, hsbc.net, direct
host-suffix, hsbcpb.com, direct
host-suffix, liveperson.net, direct
host-suffix, lpsnmedia.net, direct
host, c-hsbc.lytics.io, direct
host-suffix, tiqcdn.com, direct
host-suffix, tealiumiq.com, direct
host-suffix, eum-appdynamics.com, direct
host, cdn.optimizely.com, direct

# =========================================
# 2. 重写与 MitM 豁免部分 (供 [rewrite_remote] 读取)
# =========================================
# ⚠️ 下面这一行是“占位规则”，用来强制激活重写订阅，使下方的 hostname 生效，切勿删除！
^https?:\/\/hsbc-mitm-bypass\.invalid\/ url reject-200

hostname = -*.hsbc.com.hk, -*.hsbc.com, -*.hsbc.com.cn, -*.hsbc.co.uk, -*.hsbc.net, -*.hsbcpb.com, -*.vv1865.com, -*.online-metrix.net, -*.we-stats.com, -hsbc.edge.sdk.awswaf.com
