#!name=下厨房去广告
#!desc=拦截下厨房广告 SDK 域名、埋点与广告位接口

# > 第三方广告 SDK 与埋点（底层直接拒绝，无需解密）
host-suffix, ads.vungle.com, reject
host-suffix, chinaliftoff.io, reject
host-suffix, chinaliftoff-creatives.io, reject
host-suffix, mosspf.net, reject
host-suffix, hookspf.com, reject
host-suffix, uyunad.com, reject
host-suffix, doubleclick-cn.net, reject
host-suffix, app-ads-services.com, reject
host, imasdk.googleapis.com, reject
host, track.xiachufang.com, reject
host, trackbeat.xiachufang.com, reject

# > 下厨房自家广告位接口（需 MitM 解密）
^https?:\/\/api\.xiachufang\.com\/v[0-9]+\/ad\/lookup_(hybrid_)?ad_by_slot_name\.json url reject

hostname = api.xiachufang.com
