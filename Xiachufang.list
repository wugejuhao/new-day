[domain]
# 下厨房广告域名屏蔽
host-suffix, uyunad.com, reject
host-suffix, mosspf.net, reject
host-suffix, hookspf.com, reject
host-keyword, uyunad, reject

[rewrite_local]
# 下厨房去广告与行为拦截
^https?:\/\/api\.xiachufang\.com\/v[0-9]+\/(ads|app_home|recommend_activities) url reject-200
^https?:\/\/(ztoken|adx)\.uyunad\.com\/.* url reject-200
^https?:\/\/trackbeat\.xiachufang\.com\/sa\?.* url reject-200
^https?:\/\/da\.(mosspf|hook)spf\.com\/.* url reject-200

[mitm]
hostname = *.xiachufang.com
